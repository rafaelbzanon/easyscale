# Exemplo de configuração (spec 027). Copie para `.env` (nunca versionado) e ajuste.
#   cp .env.exemplo .env
# O compose lê o `.env` para os contêineres e para as variáveis ${...} do compose.yaml.
# Sem aspas nos valores. Modo SIMULADO: nenhum hardware real é acionado.
#
# Os valores de balança, LPR, tempos e tempo real são de DEMONSTRAÇÃO. Não foram
# calibrados com equipamento nem com o acervo de placas (AMBIENTE §8: PENDENTE).

# ---- Banco (PostgreSQL, ADR-0001) ----
# No compose o host é o serviço `db`. Para o backend rodando na máquina com o perfil
# `dev` do compose, use 127.0.0.1 (exporte por cima, sem editar este arquivo).
PESAGEM_BANCO_HOST=db
PESAGEM_BANCO_PORTA=5432
# Porta do banco do perfil `dev` no host (127.0.0.1). Mude se a 5432 da máquina estiver ocupada.
# PESAGEM_BANCO_PORTA_DEV=5432
PESAGEM_BANCO_NOME=pesagem
PESAGEM_BANCO_USUARIO=pesagem
# TROQUE. Só vale na criação do volume do banco; depois, mudar aqui não muda no banco.
PESAGEM_BANCO_SENHA=troque-esta-senha

# ---- Geral e pátio ----
# Fuso que define o "hoje" e os horários das faixas (spec 008 §6.1).
PESAGEM_PATIO_FUSO=America/Sao_Paulo
# Tamanho de página das listas (spec 007 §3.3).
PESAGEM_GERAL_TAMANHO_PAGINA_PADRAO=20
PESAGEM_GERAL_TAMANHO_PAGINA_MAXIMO=100
# Destino do proxy de /api. No compose o frontend já recebe http://backend:8000.
# Só preencha para `npm run dev` na máquina (spec 016 §7).
# PESAGEM_GERAL_URL_BACKEND=http://127.0.0.1:8000

# ---- HTTPS (lidas só pelo compose.yaml e pelo Caddyfile; o backend as ignora) ----
# Nome ou IP pelo qual o navegador acessa. Entra no certificado.
PESAGEM_HTTPS_HOST=localhost
# Porta publicada no host. Muda a origem: ajuste PESAGEM_SEGURANCA_ORIGENS_PERMITIDAS.
PESAGEM_HTTPS_PORTA=8443
# Endereço do host que recebe a porta. 127.0.0.1 = só esta máquina. Para a rede do
# pátio (totem, outros PCs), use 0.0.0.0 e proteja a porta no firewall.
PESAGEM_HTTPS_ENDERECO=127.0.0.1
# internal = CA interna do Caddy. Certificado próprio: caminho do certificado e da
# chave dentro do contêiner, separados por espaço (spec 027 §4.3).
PESAGEM_HTTPS_TLS=internal
# IP fixo do frontend (o proxy) na rede do compose. É o único de quem o uvicorn aceita
# X-Forwarded-For. Mude só se 172.28.0.0/24 já estiver em uso (e a sub-rede no compose.yaml).
PESAGEM_IP_PROXY=172.28.0.10

# ---- Segurança (ADR-0004; specs 012 e 013) ----
# Origens aceitas no cabeçalho Origin dos POST/PATCH/DELETE, separadas por vírgula.
# Precisa bater com o endereço e a porta que o navegador usa.
PESAGEM_SEGURANCA_ORIGENS_PERMITIDAS=https://localhost:8443
# Segundos sem requisição que encerram a sessão.
PESAGEM_SEGURANCA_SESSAO_TEMPO_SEM_USO_S=1800
# Falhas de login seguidas que bloqueiam o login do usuário.
PESAGEM_SEGURANCA_LOGIN_TENTATIVAS_MAXIMAS=5
# Duração do bloqueio do login, em segundos.
PESAGEM_SEGURANCA_LOGIN_BLOQUEIO_S=900
# Redes (CIDR, separadas por vírgula) que podem usar o autoatendimento do motorista.
# Vazio = rotas de autoatendimento desligadas (404). As duas variáveis abaixo só são
# lidas quando esta tem valor. Atrás do Docker, o cliente aparece com o IP real da
# rede do pátio; da própria máquina, com o gateway da rede do compose (172.28.0.1).
PESAGEM_SEGURANCA_AUTOATENDIMENTO_REDES=
# Tentativas de cadastro que não conferem antes de bloquear a origem.
PESAGEM_SEGURANCA_AUTOATENDIMENTO_TENTATIVAS_MAXIMAS=5
# Duração do bloqueio do autoatendimento, em segundos.
PESAGEM_SEGURANCA_AUTOATENDIMENTO_BLOQUEIO_S=900

# ---- Dispositivos (RNF-003) ----
# SIMULADO ou REAL. Ausente = SIMULADO. REAL impede a partida: não existe (Q-01, Q-06).
PESAGEM_BALANCA_MODO=SIMULADO
PESAGEM_CANCELA_MODO=SIMULADO
PESAGEM_CAMERA_MODO=SIMULADO

# ---- Balança (spec 002 §11 e spec 015) ----
# Peso mínimo e máximo aceitos, em kg.
PESAGEM_BALANCA_PESO_MINIMO_KG=100
PESAGEM_BALANCA_PESO_MAXIMO_KG=80000
# Leituras seguidas dentro da variação para o peso valer como estável.
PESAGEM_BALANCA_QUANTIDADE_LEITURAS_ESTAVEIS=3
# Variação máxima entre essas leituras, em kg.
PESAGEM_BALANCA_VARIACAO_MAXIMA_KG=10
# Janela em que a estabilidade é conferida, em ms.
PESAGEM_BALANCA_JANELA_ESTABILIDADE_MS=3000
# Período do ciclo de leitura da balança, em ms.
PESAGEM_BALANCA_INTERVALO_LEITURA_MS=500
# Tolerância da movimentação do peso líquido, em kg (RN-006). Ausente = 20.
PESAGEM_PESAGEM_TOLERANCIA_MOVIMENTACAO_KG=20

# ---- Câmeras e LPR (spec 005 e spec 015) ----
# Confiança mínima do reconhecimento de placa. O valor real sai da avaliação (spec 005 P-4).
PESAGEM_LPR_LIMIAR_CONFIANCA=0.800
# Período do ciclo de análise das câmeras, em ms.
PESAGEM_CAMERA_INTERVALO_ANALISE_MS=1000
# Imagem mais velha que isso é descartada como incerta (ADR-0005), em ms.
PESAGEM_CAMERA_IDADE_MAXIMA_IMAGEM_MS=2000

# ---- Tempos-limite das etapas da operação (spec 015), em ms ----
# Entrada ou retorno liberados até o caminhão posicionar.
PESAGEM_OPERACAO_TEMPO_LIMITE_POSICIONAMENTO_MS=60000
# Caminhão posicionado até a pesagem aceita.
PESAGEM_OPERACAO_TEMPO_LIMITE_PESAGEM_MS=60000
# Saída liberada até o caminhão deixar a balança.
PESAGEM_OPERACAO_TEMPO_LIMITE_SAIDA_BALANCA_MS=60000

# ---- Tempo real, SSE (ADR-0005; spec 009 §6.2), em ms ----
# Intervalo do heartbeat dos eventos.
PESAGEM_TEMPO_REAL_HEARTBEAT_MS=15000
# Sem nenhuma mensagem por este tempo, a tela fica desatualizada. Maior que o heartbeat.
PESAGEM_TEMPO_REAL_LIMITE_SEM_HEARTBEAT_MS=45000
# Intervalo mínimo entre eventos de peso lido.
PESAGEM_TEMPO_REAL_INTERVALO_PESO_MS=1000
# Intervalo mínimo entre imagens enviadas à tela.
PESAGEM_TEMPO_REAL_INTERVALO_IMAGEM_MS=2000
